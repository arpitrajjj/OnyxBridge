<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="120dp"
            android:background="@drawable/ic_logo"
            android:contentDescription="OnyxApp logo" />

        <!-- The single, required welcome text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to OnyxApp"
            android:textSize="28sp"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading library and requesting permissions…"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp" />

        <!-- Activity log (kept small so the welcome stays the focus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVITY LOG"
                android:textSize="9sp"
                android:textColor="@color/text_dim"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="@color/text_dim"
                android:text="No events yet."
                android:maxLines="12"
                android:scrollbars="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
